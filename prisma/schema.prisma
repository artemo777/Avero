generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MemberProfile {
  id               String   @id @default(cuid())
  guildId          String
  userId           String
  xp               Int      @default(0)
  level            Int      @default(0)
  lastMessageXpAt  DateTime?
  equippedBadgeItemId String?
  equippedTitleId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, xp])
}

model CurrencyAccount {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  balance      Int      @default(0)
  lastDailyAt  DateTime?
  dailyStreak  Int      @default(0)
  lastWorkAt   DateTime?
  lastScavengeAt DateTime?
  lastGameRewardAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, balance])
}

model CurrencyTransaction {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  amount    Int
  type      String
  createdAt DateTime @default(now())

  @@index([guildId, userId, createdAt])
  @@index([guildId, type, createdAt])
}


model CurrencyPurchase {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  itemId      String
  purchasedAt DateTime @default(now())

  @@unique([guildId, userId, itemId])
  @@index([guildId, userId])
}


model DailyContractClaim {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  contractId   String
  contractDate String
  reward       Int
  claimedAt    DateTime @default(now())

  @@unique([guildId, userId, contractDate, contractId])
  @@index([guildId, contractDate])
}

model GuildSettings {
  guildId         String   @id
  gamesEnabled    Boolean  @default(true)
  currencyEnabled Boolean  @default(true)
  dailyReward     Int      @default(100)
  workMinReward   Int      @default(60)
  workMaxReward   Int      @default(120)
  boosterRoleId   String?
  funderRoleId    String?
  voterRoleId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MemberTitle {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  titleId    String
  source     String   @default("milestone")
  acquiredAt DateTime @default(now())

  @@unique([guildId, userId, titleId])
  @@index([guildId, userId])
}
