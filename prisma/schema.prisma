generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MemberProfile {
  id               String   @id @default(cuid())
  guildId          String
  userId           String
  xp               Int      @default(0)
  level            Int      @default(0)
  lastMessageXpAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, xp])
}
