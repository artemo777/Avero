generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Member-owned records use the reserved "__avero_global__" guildId scope.
/// GuildSettings and MoneyRequest remain server-scoped by design.
model MemberProfile {
  id               String   @id @default(cuid())
  guildId          String
  userId           String
  xp               Int      @default(0)
  level            Int      @default(0)
  lastMessageXpAt  DateTime?
  equippedBadgeItemId String?
  equippedTitleId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, xp])
}

model CurrencyAccount {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  balance      Int      @default(0)
  gemBalance   Int      @default(0)
  lastDailyAt  DateTime?
  dailyStreak  Int      @default(0)
  lastWorkAt   DateTime?
  lastScavengeAt DateTime?
  lastGameRewardAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, balance])
}

model CurrencyTransaction {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  amount    Int
  currency  String   @default("coins")
  type      String
  createdAt DateTime @default(now())

  @@index([guildId, userId, createdAt])
  @@index([guildId, type, createdAt])
}


model CurrencyPurchase {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  itemId      String
  purchasedAt DateTime @default(now())

  @@unique([guildId, userId, itemId])
  @@index([guildId, userId])
}


model DailyContractClaim {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  contractId   String
  contractDate String
  reward       Int
  claimedAt    DateTime @default(now())

  @@unique([guildId, userId, contractDate, contractId])
  @@index([guildId, contractDate])
}

model GuildSettings {
  guildId         String   @id
  gamesEnabled    Boolean  @default(true)
  currencyEnabled Boolean  @default(true)
  dailyReward     Int      @default(100)
  workMinReward   Int      @default(60)
  workMaxReward   Int      @default(120)
  boosterRoleId   String?
  funderRoleId    String?
  voterRoleId     String?
  profileName     String?
  profileBio      String?
  profileTheme    String   @default("violet")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AutoReactionSetting {
  guildId           String   @id
  emoji             String?
  enabled           Boolean  @default(false)
  ignoredChannelIds String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AutoReactionRolePerk {
  id        String   @id @default(cuid())
  guildId   String
  roleId    String
  emoji     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, roleId])
  @@index([guildId])
}

model AutoResponseRule {
  id                       String   @id @default(cuid())
  guildId                  String
  name                     String   @db.VarChar(50)
  matchType                String   @default("contains")
  trigger                  String   @default("") @db.VarChar(200)
  responseType             String   @default("text")
  responseContent          String   @db.VarChar(2000)
  randomResponses          String[] @default([])
  enabled                  Boolean  @default(true)
  caseSensitive            Boolean  @default(false)
  priority                 Int      @default(0)
  stopOnMatch              Boolean  @default(true)
  cooldownSeconds          Int      @default(0)
  perUserCooldownSeconds   Int      @default(0)
  deleteAfterSeconds       Int      @default(0)
  allowedChannelIds        String[] @default([])
  ignoredChannelIds        String[] @default([])
  allowedRoleIds           String[] @default([])
  ignoredRoleIds           String[] @default([])
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([guildId, enabled, priority])
}

model AutoResponseCooldown {
  id              String   @id @default(cuid())
  ruleId          String
  scopeKey        String
  lastTriggeredAt DateTime @default(now())

  @@unique([ruleId, scopeKey])
  @@index([lastTriggeredAt])
}

model AutoResponseLog {
  id        String   @id @default(cuid())
  guildId   String
  ruleId    String
  userId    String
  channelId String
  status    String
  createdAt DateTime @default(now())

  @@index([guildId, status, createdAt])
  @@index([ruleId, createdAt])
}

model MemberMessageCounter {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, count])
}

model AutoResponseMilestone {
  id              String   @id @default(cuid())
  guildId         String
  threshold       Int
  responseContent String   @db.VarChar(1800)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([guildId, threshold])
  @@index([guildId, enabled, threshold])
}

model MemberMessageMilestoneAward {
  id              String   @id @default(cuid())
  guildId         String
  userId          String
  threshold       Int
  countAtAward    Int
  channelId       String
  responseContent String   @db.VarChar(1800)
  status          String   @default("pending")
  attempts        Int      @default(0)
  lastError       String?  @db.VarChar(500)
  claimedAt       DateTime?
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([guildId, userId, threshold])
  @@index([guildId, userId, status])
  @@index([status, claimedAt])
}

model MemberTitle {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  titleId    String
  source     String   @default("milestone")
  acquiredAt DateTime @default(now())

  @@unique([guildId, userId, titleId])
  @@index([guildId, userId])
}

model MemberJob {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  jobId        String
  shifts       Int      @default(0)
  promotions   Int      @default(0)
  lastShiftAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, jobId])
}

model MoneyRequest {
  id          String   @id @default(cuid())
  guildId     String
  requesterId String
  targetId    String
  amount      Int
  status      String   @default("pending")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  respondedAt DateTime?

  @@index([guildId, targetId, status, expiresAt])
  @@index([guildId, requesterId, createdAt])
}
