# HTTP port for the local Avero health server
PORT=3000

# Discord application credentials (never commit real values)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: one server ID used to remove legacy server-scoped copies after global registration
DISCORD_GUILD_ID=

# PostgreSQL connection string, for example:
# postgresql://avero:password@localhost:5432/avero?schema=public
DATABASE_URL=


# Gemini AI assistant (create a key in Google AI Studio; keep it in a secret store)\nGEMINI_API_KEY=\nGEMINI_MODEL=gemini-3.1-flash-lite\n\n# One-time Engauge XP/stat migration only. Remove these secrets after verified import.
ENGAUGE_API_TOKEN=
ENGAUGE_SERVER_ID=
ENGAUGE_API_BASE_URL=https://engau.ge
ENGAUGE_API_AUTH_HEADER=Authorization
ENGAUGE_API_AUTH_SCHEME=Bearer
