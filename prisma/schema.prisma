generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MemberProfile {
  id               String   @id @default(cuid())
  guildId          String
  userId           String
  xp               Int      @default(0)
  level            Int      @default(0)
  lastMessageXpAt  DateTime?
  equippedBadgeItemId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, xp])
}

model CurrencyAccount {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  balance      Int      @default(0)
  lastDailyAt  DateTime?
  lastWorkAt   DateTime?
  lastScavengeAt DateTime?
  lastGameRewardAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, balance])
}

model CurrencyTransaction {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  amount    Int
  type      String
  createdAt DateTime @default(now())

  @@index([guildId, userId, createdAt])
  @@index([guildId, type, createdAt])
}


model CurrencyPurchase {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  itemId      String
  purchasedAt DateTime @default(now())

  @@unique([guildId, userId, itemId])
  @@index([guildId, userId])
}


model DailyContractClaim {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  contractId   String
  contractDate String
  reward       Int
  claimedAt    DateTime @default(now())

  @@unique([guildId, userId, contractDate, contractId])
  @@index([guildId, contractDate])
}
