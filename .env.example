# HTTP port for the local Avero health server
PORT=3000

# Discord application credentials (never commit real values)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# PostgreSQL connection string, for example:
# postgresql://avero:password@localhost:5432/avero?schema=public
DATABASE_URL=

# Optional channel for level-up announcements; unset = announce in the message channel
LEVEL_UP_CHANNEL_ID=

# Message XP settings (defaults: 60 seconds, 15–25 XP)
LEVEL_XP_COOLDOWN_MS=60000
LEVEL_MIN_MESSAGE_XP=15
LEVEL_MAX_MESSAGE_XP=25

# Optional JSON object mapping milestone levels to Discord role IDs
# Example: {"5":"123456789012345678","10":"234567890123456789"}
LEVEL_ROLE_REWARDS=
