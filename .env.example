# HTTP port for the local Avero health server
PORT=3000

# Discord application credentials (never commit real values)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: one server ID used to remove legacy server-scoped copies after global registration
DISCORD_GUILD_ID=

# PostgreSQL connection string
DATABASE_URL=

# Gemini AI assistant (keep the real key in a secret store)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# One-time Engauge XP/stat migration only. Remove these secrets after verified import.
ENGAUGE_API_TOKEN=
ENGAUGE_SERVER_ID=
ENGAUGE_API_BASE_URL=https://engau.ge
ENGAUGE_API_AUTH_HEADER=Authorization
ENGAUGE_API_AUTH_SCHEME=Bearer
